/target
*.exe
*.pdb
/.artifacts
# rustc's default output name (`rustc foo.rs` with no -o) — a throwaway, never committed
/rust_out
/.claude/.active-transcript
.claude/skills


/.worktrees/**
!/.worktrees/.gitkeep

# >>> CFG: shared ignored artifacts
# superpowers audit artifacts
.superpowers/

# Per-machine agent config (skill scoping settings.local.json, CLAUDE.local.md) — never committed
*.local.*

# Ephemeral AI implementation plans — relevant only to the task that produced them, not
# git history. Specs/ADRs + commit history are the durable record. (Rationale:
# config-handler docs/planning/plans/README.md.)
docs/planning/plans/*.md
!docs/planning/plans/README.md

*.swp

*:Zone.Identifier

.playwright-mcp
.artifacts/
testResults.xml

/secrets/

# Canonical secret-bearing files — defense-in-depth; never commit (any depth).
*.env
!*.env.example
auth.json
credentials.json
.credentials.json
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pfx
*.p12

/.worktrees/**
!/.worktrees/.gitkeep
