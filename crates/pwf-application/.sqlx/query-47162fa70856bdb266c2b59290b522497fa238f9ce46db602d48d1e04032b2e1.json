  "query": "\n            SELECT\n                lane AS \"lane!\",\n                marker AS \"marker!\",\n                header AS \"header!\"\n            FROM task_prompt_lanes\n            ORDER BY CASE lane\n                WHEN 'goals' THEN 0\n                WHEN 'context' THEN 1\n                WHEN 'constraints' THEN 2\n                WHEN 'done_when' THEN 3\n                ELSE 4\n            END\n            ",
